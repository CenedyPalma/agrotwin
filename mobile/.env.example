# Copy to mobile/.env and edit. Never use "localhost" here — a phone cannot
# reach your computer's loopback address.
#
#   Android Emulator ............ http://10.0.2.2:8000   (alias for the host machine)
#   Physical Android phone ...... http://<your laptop's LAN IP>:8000, e.g. http://192.168.1.100:8000
#
# Find the LAN IP with `ipconfig` (Windows) or `ip addr` (Linux). The backend
# must listen on 0.0.0.0, not 127.0.0.1 — see mobile/README.md.

# FastAPI backend (same server the web app uses)
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Next.js web app — hosts the Cesium Digital Twin viewer and the static tile pyramids
EXPO_PUBLIC_WEB_VIEWER_URL=http://192.168.1.100:3000

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# Only needed for a development/production build (not for Expo Go):
# Google Maps key for react-native-maps on Android.
# GOOGLE_MAPS_ANDROID_API_KEY=
